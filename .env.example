# Copy this file to .env and fill in your own values. Never commit .env.

# Database password used by both the postgres container and the app.
POSTGRES_PASSWORD=change-me

# Base64-encoded HMAC key of at least 256 bits. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Password for the "admin" account created on first startup.
# Leave empty to skip creating the admin account.
ADMIN_PASSWORD=
